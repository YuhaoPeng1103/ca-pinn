\newlabel{tab:main}{{1}{7}{Balancing all four losses, including the parameter prior. Weights are those at the end of training; ``$c_{\text {prior}}$'' is the anchor-coupling ratio of \eqref {eq:coupling}. Errors are relative to the true parameter values}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Prior weight during training when all four losses are balanced jointly. The decoupled prior is assigned a coupling ratio of exactly zero by all three balancers, and each then responds according to its functional form: LL-EMA decays to $1.6\times 10^{-5}$, LRA diverges to $3.3\times 10^{7}$, and ReLoBRaLo --- which uses loss statistics rather than gradients --- remains bounded near one.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:failure}{{1}{7}{Prior weight during training when all four losses are balanced jointly. The decoupled prior is assigned a coupling ratio of exactly zero by all three balancers, and each then responds according to its functional form: LL-EMA decays to $1.6\times 10^{-5}$, LRA diverges to $3.3\times 10^{7}$, and ReLoBRaLo --- which uses loss statistics rather than gradients --- remains bounded near one}{figure.1}{}}
